GOOGLE_GENERATIVE_AI_API_KEY=YOUR_GEMINI_API_KEY

CHROMA_API_KEY=YOUR_CHROMA_API_KEY
CHROMA_TENANT=YOUR_CHROMA_TENANT
CHROMA_DATABASE=YOUR_DB_NAME

# Prefer a full Atlas URI (includes user + password):
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/localrag?retryWrites=true&w=majority
# Or use MONGO_URL (also supported by the app):
# MONGO_URL=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority

# Optional / unused by Cloud Chroma path:
CHROMA_URL=http://localhost:8000
CHROMA_CLOUD_HOST=api.trychroma.com
CHROMA_CLOUD_PORT=8000
